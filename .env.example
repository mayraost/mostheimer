DATABASE_URL=postgresql://user:pw@coolify-postgres:5432/mostheimer
PAYLOAD_SECRET=YOUR_SECRET_HERE
APP_PORT=3300

# Google Tag Manager (optional). Read by the browser, so it must be
# NEXT_PUBLIC_* and present at BUILD time (Next.js inlines it). Empty = no
# container; the consent banner and Consent Mode still work.
NEXT_PUBLIC_GTM_ID=

# Seed routes (/api/seed-home, /api/seed-globals) are POST-only and disabled in
# production by default. They still require an admin session when enabled.
ALLOW_SEED=false
