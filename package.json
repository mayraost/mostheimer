{
  "name": "mostheimer",
  "version": "1.0.0",
  "description": "Next.js 16 + Payload 4 CMS site (en/de)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "next build",
    "ci": "payload migrate && next build",
    "dev": "next dev",
    "devsafe": "rm -rf .next && next dev",
    "generate:importmap": "payload generate:importmap",
    "generate:types": "payload generate:types",
    "generate:css": "tsx scripts/build-404-critical-css.ts",
    "prebuild": "npm run generate:css",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "payload": "payload",
    "start": "next start",
    "typecheck": "node node_modules/@typescript/native/bin/tsc --noEmit",
    "test": "npm run test:int && npm run test:e2e",
    "test:e2e": "NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "vitest run --config ./vitest.config.mts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "4.0.0-beta.6",
    "@payloadcms/live-preview-react": "4.0.0-beta.6",
    "@payloadcms/next": "4.0.0-beta.6",
    "@payloadcms/plugin-mcp": "4.0.0-beta.6",
    "@payloadcms/richtext-lexical": "4.0.0-beta.6",
    "@payloadcms/transformer-sharp": "4.0.0-beta.6",
    "@payloadcms/ui": "4.0.0-beta.6",
    "@tailwindcss/postcss": "4.3.4",
    "dotenv": "18.0.9",
    "graphql": "16.14.2",
    "lucide-react": "1.67.0",
    "next": "16.4.5",
    "payload": "4.0.0-beta.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/compat": "2.1.1",
    "@eslint/eslintrc": "3.3.7",
    "@playwright/test": "1.64.1",
    "@tailwindcss/node": "4.3.4",
    "@tailwindcss/postcss": "4.3.4",
    "@tailwindcss/turbopack": "4.3.4",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-unused-imports": "4.4.1",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.4",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=26",
    "npm": "^11"
  },
  "overrides": {
    "dompurify": "3.4.17"
  }
}
