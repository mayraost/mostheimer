{
  "name": "mostheimer",
  "version": "1.0.0",
  "description": "Next.js 16 + Payload 4 CMS site (en/de)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "next build",
    "ci": "payload migrate && next build",
    "dev": "next dev",
    "devsafe": "rm -rf .next && next dev",
    "generate:importmap": "payload generate:importmap",
    "generate:types": "payload generate:types",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "payload": "payload",
    "start": "next start",
    "test": "npm run test:int && npm run test:e2e",
    "test:e2e": "NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "vitest run --config ./vitest.config.mts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "4.0.0-beta.6",
    "@payloadcms/db-sqlite": "4.0.0-beta.6",
    "@payloadcms/next": "4.0.0-beta.6",
    "@payloadcms/richtext-lexical": "4.0.0-beta.6",
    "@payloadcms/transformer-sharp": "^4.0.0-beta.6",
    "@payloadcms/ui": "4.0.0-beta.6",
    "@tailwindcss/postcss": "^4.3.3",
    "dotenv": "^18.0.9",
    "graphql": "^16.14.2",
    "lucide-react": "^1.66.0",
    "next": "^16.4.3",
    "payload": "4.0.0-beta.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24",
    "npm": "^11"
  }
}
